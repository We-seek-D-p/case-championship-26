{
  "name": "red-wings-calculator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "data:prepare": "tsx scripts/prepare-data.ts",
    "dev": "pnpm data:prepare && nuxt dev --host 127.0.0.1",
    "build": "pnpm data:prepare && nuxt build",
    "generate": "pnpm data:prepare && nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@nuxt/ui": "^4.0.0",
    "csv-parse": "^6.0.0",
    "echarts": "^6.0.0",
    "maplibre-gl": "^5.0.0",
    "nuxt": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vue-tsc": "^3.0.0"
  }
}
